# Public issuance profile used for LathamZ Software Signing v1.
# Existing identity is stored outside Git; normal app updates must reuse it.
# Validity (1825 days) and random serial were issuance parameters, not req config fields.
[req]
prompt = no
default_bits = 3072
default_md = sha256
distinguished_name = subject
x509_extensions = personal_codesign

[subject]
CN = LathamZ Software Signing

[personal_codesign]
basicConstraints = critical,CA:FALSE
keyUsage = critical,digitalSignature
extendedKeyUsage = critical,codeSigning
subjectKeyIdentifier = hash
authorityKeyIdentifier = keyid:always
